+
+# These are the UAVObjects supposed to be build as part of the OpenPilot target
+# (all architectures)
+
+UAVOBJSRCFILENAMES =
+UAVOBJSRCFILENAMES += statusgrounddrive
+UAVOBJSRCFILENAMES += pidstatus
