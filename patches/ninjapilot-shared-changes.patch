@@ -0,0 +1,10 @@
+<xml>
+    <object name="SettingsGeneration" singleinstance="true" settings="false" category="System">
+        <description>Session token for ground-station settings caching: seeded randomly at boot and incremented whenever any settings object changes, so a reconnecting GCS can skip refetching settings it already holds.</description>
+        <field name="Generation" units="" type="uint32" elements="1"/>
+        <access gcs="readonly" flight="readwrite"/>
+        <telemetrygcs acked="false" updatemode="manual" period="0"/>
+        <telemetryflight acked="false" updatemode="onchange" period="0"/>
+        <logging updatemode="manual" period="0"/>
+    </object>
+</xml>
